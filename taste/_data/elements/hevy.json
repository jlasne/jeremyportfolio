   "css": ".x-hevy-set-rows{position:relative;box-sizing:border-box;width:393px;padding:16px 0;border-radius:24px;background:#FFFFFF;overflow:hidden;font-family:Inter,system-ui,sans-serif;font-size:17px;font-weight:500;line-height:20px;letter-spacing:0;color:#ACB0B4;text-align:left;white-space:nowrap;font-variant-numeric:tabular-nums}\n.x-hevy-set-rows *{box-sizing:border-box;margin:0;padding:0}\n.x-hevy-set-rows__row{position:relative;height:51.8px;background:#FFFFFF}\n.x-hevy-set-rows__row--done{background:#C7FEA0}\n.x-hevy-set-rows__prev,.x-hevy-set-rows__kg,.x-hevy-set-rows__reps{position:absolute;top:15.9px}\n.x-hevy-set-rows__prev{left:24.4px}\n.x-hevy-set-rows__x{margin-left:7px}\n.x-hevy-set-rows__row--done .x-hevy-set-rows__prev{color:#7F8888}\n.x-hevy-set-rows__kg,.x-hevy-set-rows__reps{width:60px;margin-left:-30px;font-weight:700;letter-spacing:-0.02em;text-align:center}\n.x-hevy-set-rows__kg{left:185.8px}\n.x-hevy-set-rows__reps{left:269.2px}\n.x-hevy-set-rows__row--done .x-hevy-set-rows__kg,.x-hevy-set-rows__row--done .x-hevy-set-rows__reps{color:#141616}\n.x-hevy-set-rows__box{position:absolute;left:344.3px;top:13.3px;width:25.2px;height:25.2px;border-radius:6.5px;background:#E0E0E0}\n.x-hevy-set-rows__row--done .x-hevy-set-rows__box{background:#56BD23}\n.x-hevy-set-rows__check{display:block;width:25.2px;height:25.2px}\n.x-hevy-set-rows__add{display:flex;align-items:center;justify-content:center;gap:10.3px;width:358.4px;height:41.7px;margin:17px 0 0 17.3px;border-radius:10px;background:#F3F4F8;color:#131417;letter-spacing:-0.01em}\n.x-hevy-set-rows__plus{display:block;width:14px;height:14.5px}",
