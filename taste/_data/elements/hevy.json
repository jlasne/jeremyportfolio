   "css": ".x-hevy-profile-header{position:relative;box-sizing:border-box;width:392px;height:218px;border-radius:24px;background:#FFFFFF;font-family:Inter,system-ui,sans-serif;font-size:16.7px;font-weight:400;line-height:20px;letter-spacing:0;color:#1A1A1C;text-align:left;white-space:nowrap}\n.x-hevy-profile-header *{box-sizing:border-box;margin:0;padding:0}\n.x-hevy-profile-header__avatar{position:absolute;left:16px;top:16px;display:flex;align-items:center;justify-content:center;width:88.2px;height:88.2px;border-radius:50%;background:#D0DBE7;color:#3F4B5C;font-size:32px;font-weight:600;line-height:1}\n.x-hevy-profile-header__name{position:absolute;left:120.8px;top:21.9px;font-size:18.6px;font-weight:700;line-height:22px}\n.x-hevy-profile-header__stat{position:absolute;top:55.1px;display:flex;flex-direction:column}\n.x-hevy-profile-header__stat--1{left:120.5px}\n.x-hevy-profile-header__stat--2{left:204.7px}\n.x-hevy-profile-header__stat--3{left:289px}\n.x-hevy-profile-header__slabel{font-size:13.5px;line-height:16px;color:#8A8C91}\n.x-hevy-profile-header__count{margin-top:5.5px;font-size:16.7px;line-height:20px}\n.x-hevy-profile-header__bio{position:absolute;left:20.15px;top:122.3px;display:flex;align-items:flex-end;height:20px;font-size:16.7px;line-height:20px}\n.x-hevy-profile-header__pin{display:block;flex:none;width:8.4px;height:15.2px;margin-bottom:3.9px}\n.x-hevy-profile-header__t1{margin-left:4.6px}\n.x-hevy-profile-header__arm{display:block;flex:none;width:14.6px;height:16.3px;margin:0 0.8px 3.1px 5.9px}\n.x-hevy-profile-header__follow{position:absolute;left:16px;top:160px;display:flex;align-items:center;justify-content:center;width:360px;height:41.6px;border-radius:10px;background:#267EE8;color:#FFFFFF;font-size:16.5px;font-weight:500;line-height:20px}",
