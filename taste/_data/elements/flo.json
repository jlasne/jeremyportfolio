   "why": "Two tints split the month, pink for the 5 period days and teal for the 7 fertile days, and one solid circle marks day 17.",
   "html": "<div class=\"x-flo-cycle-calendar\"><div class=\"x-flo-cycle-calendar__dows\"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div><div class=\"x-flo-cycle-calendar__month\"><div class=\"x-flo-cycle-calendar__band x-flo-cycle-calendar__band--period\"></div><div class=\"x-flo-cycle-calendar__band x-flo-cycle-calendar__band--fertile1\"></div><div class=\"x-flo-cycle-calendar__band x-flo-cycle-calendar__band--fertile2\"></div><span class=\"x-flo-cycle-calendar__d\">1</span><span class=\"x-flo-cycle-calendar__d\">2</span><span class=\"x-flo-cycle-calendar__d\">3</span><span class=\"x-flo-cycle-calendar__d\">4</span><span class=\"x-flo-cycle-calendar__d\">5</span><span class=\"x-flo-cycle-calendar__d\">6</span><span class=\"x-flo-cycle-calendar__d\">7</span><span class=\"x-flo-cycle-calendar__d\">8</span><span class=\"x-flo-cycle-calendar__d\">9</span><span class=\"x-flo-cycle-calendar__d\">10</span><span class=\"x-flo-cycle-calendar__d\">11</span><span class=\"x-flo-cycle-calendar__d\">12</span><span class=\"x-flo-cycle-calendar__d\">13</span><span class=\"x-flo-cycle-calendar__d\">14</span><span class=\"x-flo-cycle-calendar__d\">15</span><span class=\"x-flo-cycle-calendar__d\">16</span><span class=\"x-flo-cycle-calendar__d\"><span class=\"x-flo-cycle-calendar__ovu\">17</span></span><span class=\"x-flo-cycle-calendar__d\">18</span><span class=\"x-flo-cycle-calendar__d\">19</span><span class=\"x-flo-cycle-calendar__d\">20</span><span class=\"x-flo-cycle-calendar__d\">21</span><span class=\"x-flo-cycle-calendar__d\">22</span><span class=\"x-flo-cycle-calendar__d\">23</span><span class=\"x-flo-cycle-calendar__d\">24</span><span class=\"x-flo-cycle-calendar__d\">25</span><span class=\"x-flo-cycle-calendar__d\">26</span><span class=\"x-flo-cycle-calendar__d\">27</span><span class=\"x-flo-cycle-calendar__d\">28</span><span class=\"x-flo-cycle-calendar__d\">29</span><span class=\"x-flo-cycle-calendar__d\">30</span><div class=\"x-flo-cycle-calendar__stem\"></div><div class=\"x-flo-cycle-calendar__callout\"><span class=\"x-flo-cycle-calendar__pre\">Prediction: Day of</span><span class=\"x-flo-cycle-calendar__big\">ovulation</span></div></div></div>",
   "css": ".x-flo-cycle-calendar{position:relative;box-sizing:border-box;width:393px;padding:13.5px 20.25px 16px 16.45px;border-radius:24px;background:#FFFFFF;font-family:Inter,system-ui,sans-serif;font-size:16.5px;font-weight:400;line-height:1;letter-spacing:0;color:#231318;text-align:center;white-space:nowrap}\n.x-flo-cycle-calendar *{box-sizing:border-box;margin:0;padding:0}\n.x-flo-cycle-calendar__dows{display:grid;grid-template-columns:repeat(7,1fr);font-size:11px;font-weight:500;line-height:13px;color:#E66483}\n.x-flo-cycle-calendar__month{position:relative;display:grid;grid-template-columns:repeat(7,1fr);grid-template-rows:repeat(5,54.3px);align-content:start;height:333.55px;margin-top:39.25px}\n.x-flo-cycle-calendar__d{position:relative;display:flex;align-items:center;justify-content:center}\n.x-flo-cycle-calendar__band{position:absolute;height:41px;border-radius:8.3px}\n.x-flo-cycle-calendar__band--period{left:5.45px;top:6.65px;width:243.6px;background:#FFBFCD}\n.x-flo-cycle-calendar__band--fertile1{left:209.05px;top:60.95px;width:141.8px;background:#B3E4E8}\n.x-flo-cycle-calendar__band--fertile2{left:5.45px;top:115.25px;width:192.7px;background:#B3E4E8}\n.x-flo-cycle-calendar__ovu{display:flex;align-items:center;justify-content:center;flex:none;width:51.5px;height:51.5px;border-radius:50%;background:#1DA4A7;color:#FFFFFF;font-size:19.6px;font-weight:700}\n.x-flo-cycle-calendar__stem{position:absolute;left:137.72px;top:157.18px;width:65.07px;height:4.2px;background:#1DA4A7;transform-origin:0 50%;transform:rotate(66.02deg)}\n.x-flo-cycle-calendar__callout{position:absolute;left:128.55px;top:213.55px;display:flex;flex-direction:column;align-items:center;justify-content:center;width:120px;height:120px;border-radius:50%;background:#1DA4A7;color:#FFFFFF;font-weight:600}\n.x-flo-cycle-calendar__pre{font-size:9px;line-height:12px}\n.x-flo-cycle-calendar__big{font-size:20px;line-height:22px;letter-spacing:-0.01em}",
   "fonts": [
