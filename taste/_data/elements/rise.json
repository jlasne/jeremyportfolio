   "css": ".x-rise-habit-list{position:relative;box-sizing:border-box;width:399px;height:427px;padding:16px;border-radius:24px;overflow:hidden;background:#16151A;box-shadow:inset 0 1px 0 #333237;font-family:'Work Sans',system-ui,sans-serif;font-size:17px;font-weight:400;line-height:1;letter-spacing:0;color:#FFFFFF;text-align:left;white-space:nowrap}.x-rise-habit-list *{box-sizing:border-box;margin:0;padding:0}.x-rise-habit-list__grab{position:absolute;left:181.5px;top:8px;width:36px;height:5px;border-radius:2.5px;background:#FFFFFF}.x-rise-habit-list__title{position:absolute;left:16.2px;top:23.72px;font-size:22px}.x-rise-habit-list__badge{position:absolute;left:261px;top:26.6px;width:122px;height:20.8px;border:1px solid #333237;border-radius:10.4px}.x-rise-habit-list__bolt{position:absolute;left:7.8px;top:3.4px;display:block;width:9px;height:12px}.x-rise-habit-list__great{position:absolute;left:21.4px;top:1.98px;font-size:13px;letter-spacing:-0.03em;color:#FCFCFC}.x-rise-habit-list__day{font-weight:700;letter-spacing:-0.01em;color:#8C58FC}.x-rise-habit-list__list{position:absolute;left:16px;top:68px;width:367px;height:344.5px;border-radius:12px;overflow:hidden;background:#323335}.x-rise-habit-list__row{position:absolute;left:0;width:367px;height:56.5px;background:#22222A}.x-rise-habit-list__row--1{top:1.0px}.x-rise-habit-list__row--2{top:58.5px}.x-rise-habit-list__row--3{top:116.0px}.x-rise-habit-list__row--4{top:173.5px}.x-rise-habit-list__row--5{top:231.0px}.x-rise-habit-list__icon{position:absolute;left:12.5px;top:17.75px;display:block;width:21px;height:21px}.x-rise-habit-list__name{position:absolute;left:41.6px;top:18.02px;font-size:17px;letter-spacing:-0.01em}.x-rise-habit-list__bell{position:absolute;left:315.8px;top:20px;display:block;width:17px;height:17px}.x-rise-habit-list__chev{position:absolute;left:344.3px;top:18.75px;display:block;width:10.5px;height:19px}.x-rise-habit-list__add{position:absolute;left:0;top:288.5px;width:367px;height:56px;background:#1