r;top:183.69px}.x-huckleberry-sleep-trends__cval{position:absolute;left:205.64999999999998px;width:140px;text-align:center;top:207.55px;font-size:22.7px;font-weight:600;letter-spacing:-0.03em;color:#45526A}.x-huckleberry-sleep-trends__trend{position:absolute;left:47.4px;top:305.7px;font-family:Nunito,sans-serif;font-size:14.1px;font-weight:500;color:#888888}.x-huckleberry-sleep-trends__bold{font-weight:700}",
