   "css": ".x-strava-activity-stats{box-sizing:border-box;width:376px;padding:16px;background:#141414;border-radius:24px;font-family:\"Inter\",system-ui,sans-serif;font-size:12px;font-weight:400;line-height:1;letter-spacing:0;color:#FFFFFF;text-align:left;white-space:nowrap}.x-strava-activity-stats *{box-sizing:border-box;margin:0;padding:0}.x-strava-activity-stats__head{position:relative;height:40px}.x-strava-activity-stats__avatar{position:absolute;left:2px;top:0;display:block;width:37px;height:40px}.x-strava-activity-stats__shield{display:block;width:37px;height:40px}.x-strava-activity-stats__initials{position:absolute;left:0;top:12.45px;width:37px;font-size:15px;font-weight:700;text-align:center}.x-strava-activity-stats__name{position:absolute;left:53.6px;top:3.81px;font-size:12.5px;font-weight:700;letter-spacing:-0.02em}.x-strava-activity-stats__shoe{position:absolute;left:53.6px;top:23.6px;display:block;width:16px;height:15px}.x-strava-activity-stats__meta{position:absolute;left:73.6px;top:26.85px;font-size:10.6px;letter-spacing:-0.02em;color:#E2E2E0}.x-strava-activity-stats__more{position:absolute;right:1px;top:5px;display:block;width:15.4px;height:4.8px}.x-strava-activity-stats__title{position:relative;top:27.65px;height:0;font-size:19.4px;font-weight:500;line-height:19.4px;letter-spacing:-0.012em}.x-strava-activity-stats__stats{position:relative;height:35.6px;margin-top:64px}.x-strava-activity-stats__label,.x-strava-activity-stats__value,.x-strava-activity-stats__awards{position:absolute;left:0;display:block}.x-strava-activity-stats__label{top:3.76px;font-size:10.7px;line-height:10.7px;letter-spacing:-0.015em;color:#F1F1F0}.x-strava-activity-stats__value{top:19.07px;font-size:16.6px;font-weight:500;line-height:16.6px;letter-spacing:-0.02em}.x-strava-activity-stats__c2{left:77.5px}.x-strava-activity-stats__c3{left:165.5px}.x-strava-activity-stats__c4{left:auto;right:-0.7px;letter-spacing:-0.035em}.x-strava-activity-stats__value.x-strava-activity-stats__c4{ri