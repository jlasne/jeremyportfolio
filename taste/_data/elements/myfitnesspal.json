   "html": "<div class=\"x-myfitnesspal-reminder-sheet\"><svg class=\"x-myfitnesspal-reminder-sheet__close\" viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M1.6 1.6L12.4 12.4M12.4 1.6L1.6 12.4\" fill=\"none\" stroke=\"#0C121C\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><div class=\"x-myfitnesspal-reminder-sheet__title\"><span class=\"x-myfitnesspal-reminder-sheet__line\">Want a reminder for your</span><span class=\"x-myfitnesspal-reminder-sheet__line\">weekly dose?</span></div><div class=\"x-myfitnesspal-reminder-sheet__sub\">Pick your preferred time:</div><div class=\"x-myfitnesspal-reminder-sheet__fields\"><div class=\"x-myfitnesspal-reminder-sheet__field\">Wednesdays</div><div class=\"x-myfitnesspal-reminder-sheet__field\">12 PM</div></div><div class=\"x-myfitnesspal-reminder-sheet__help\">We prefilled day/time from your recent log</div><div class=\"x-myfitnesspal-reminder-sheet__button\">Turn on weekly reminder</div></div>",
