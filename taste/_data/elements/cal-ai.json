25 14.2Z\" fill=\"#FFFFFF\" stroke=\"#FFFFFF\" stroke-width=\"4.2\"/><circle cx=\"6.9\" cy=\"3.95\" r=\"2.3\"/><path d=\"M1.5500000000000007 14.2C1.5500000000000007 11.6 4 9.9 6.9 9.9C9.8 9.9 12.25 11.6 12.25 14.2Z\"/></g></svg><span class=\"x-cal-ai-tab-bar__label\">Groups</span></div><div class=\"x-cal-ai-tab-bar__tab x-cal-ai-tab-bar__tab--profile\"><span class=\"x-cal-ai-tab-bar__avatar\">JD</span><span class=\"x-cal-ai-tab-bar__label\">Profile</span></div></div><div class=\"x-cal-ai-tab-bar__add\"><svg class=\"x-cal-ai-tab-bar__plus\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 1.45V18.55M1.45 10H18.55\" stroke=\"#FFFFFF\" stroke-width=\"2.9\" stroke-linecap=\"round\"/></svg></div></div>",
   "css": ".x-cal-ai-tab-bar{box-sizing:border-box;display:flex;align-items:flex-start;gap:12.5px;width:384px;padding:16px;background:#F9F8FE;border-radius:24px;font-family:\"Inter\",system-ui,sans-serif;font-size:9.6px;font-weight:500;line-height:1;letter-spacing:0;color:#7F7F80;text-align:center;white-space:nowrap}.x-cal-ai-tab-bar *{box-sizing:border-box;margin:0;padding:0}.x-cal-ai-tab-bar__bar{position:relative;flex:none;width:277.1px;height:62.3px;border-radius:31.15px;background:#FFFFFF;box-shadow:0 4px 16px rgba(29,26,35,0.08)}.x-cal-ai-tab-bar__pill{position:absolute;left:4.2px;top:4.4px;display:block;width:70.4px;height:52.3px;border-radius:26.15px;background:#EDEDED}.x-cal-ai-tab-bar__tab{position:absolute;top:0;display:flex;flex-direction:column;align-items:center;width:66px;padding-top:10.2px}.x-cal-ai-tab-bar__tab--home{left:6.4px;padding-top:11.2px;color:#1D1A22;font-weight:700}.x-cal-ai-tab-bar__tab--home .x-cal-ai-tab-bar__label{margin-top:3.41px}.x-cal-ai-tab-bar__tab--progress{left:72.4px}.x-cal-ai-tab-bar__tab--groups{left:138.5px}.x-cal-ai-tab-bar__tab--profile{left:204.6px;padding-top:11.6px}.x-cal-ai-tab-bar__icon{display:block;width:24px;height:24px}.x-cal-ai-tab-bar__icon--wide{width:32px;height:16px;margin:4px 0}.x-cal-ai-tab-bar__label{display:block;margin-top:4.41px;font-size:9.6px;line-height:9.6px}.x-cal-ai-tab-bar__avatar{display:block;width:25px;height:25px;border-radius:50%;background:linear-gradient(180deg,#0187AE 0%,#4FB0D0 55%,#86C9E1 100%);color:#FFFFFF;font-size:12px;font-weight:700;line-height:25px}.x-cal-ai-tab-bar__tab--profile .x-cal-ai-tab-bar__label{margin-top:2.91px}.x-cal-ai-tab-bar__add{display:flex;flex:none;align-items:center;justify-content:center;width:62.1px;height:62.1px;border-radius:50%;background:#1D1A23;box-shadow:0 6px 16px rgba(29,26,35,0.25)}.x-cal-ai-tab-bar__plus{position:relative;top:0.8px;display:block;width:20px;height:20px}",
