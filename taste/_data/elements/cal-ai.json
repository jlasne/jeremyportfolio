   "html": "<div class=\"x-cal-ai-fix-results\"><div class=\"x-cal-ai-fix-results__btn x-cal-ai-fix-results__btn--fix\"><svg class=\"x-cal-ai-fix-results__spark\" viewBox=\"0 0 15 15\" aria-hidden=\"true\"><path d=\"M6.9 0.7Q7.5 -0.4 8.1 0.7C8.4 4.6 10.4 6.6 14.3 6.9Q15.4 7.5 14.3 8.1C10.4 8.4 8.4 10.4 8.1 14.3Q7.5 15.4 6.9 14.3C6.6 10.4 4.6 8.4 0.7 8.1Q-0.4 7.5 0.7 6.9C4.6 6.6 6.6 4.6 6.9 0.7Z\" fill=\"#1D1B21\"/></svg><span class=\"x-cal-ai-fix-results__text\">Fix Results</span></div><div class=\"x-cal-ai-fix-results__btn x-cal-ai-fix-results__btn--done\"><span class=\"x-cal-ai-fix-results__text\">Done</span></div></div>",
   "css": ".x-cal-ai-fix-results{box-sizing:border-box;display:flex;gap:10px;width:372.5px;padding:16px;background:#FFFFFF;border-radius:24px;font-family:\"Inter\",system-ui,sans-serif;font-size:16px;font-weight:500;line-height:1;letter-spacing:0;color:#1D1B21;text-align:center;white-space:nowrap}.x-cal-ai-fix-results *{box-sizing:border-box;margin:0;padding:0}.x-cal-ai-fix-results__btn{display:flex;flex:none;align-items:center;justify-content:center;width:165.3px;height:48.2px;border-radius:24.1px}.x-cal-ai-fix-results__btn--fix{gap:11.6px;padding-right:0.8px;background:#FFFFFF;border:1px solid #D6D5DB}.x-cal-ai-fix-results__btn--done{background:#1D1A23;color:#FFFFFF}.x-cal-ai-fix-results__spark{display:block;width:15px;height:15px}.x-cal-ai-fix-results__text{display:block;font-size:16px;line-height:16px}",
   "fonts": [
    {
     "family": "Inter",
     "weight": 500
    }
   ],
   "size": {
    "w": 373,
