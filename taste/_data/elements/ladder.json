   "css": ".x-ladder-home-header{position:relative;box-sizing:border-box;width:399px;height:190px;padding:16px;border-radius:24px;background:#0E0E0E;font-family:Inter,system-ui,sans-serif;font-size:12px;font-weight:400;line-height:1;letter-spacing:0;color:#FFFFFF;text-align:left;white-space:nowrap}\n.x-ladder-home-header *{box-sizing:border-box;margin:0;padding:0}\n.x-ladder-home-header__top{position:relative;height:33.5px}\n.x-ladder-home-header__glyph{position:absolute;left:0;top:5.2px;display:block;width:23px;height:23px}\n.x-ladder-home-header__title{position:absolute;left:32px;top:3.6px;font-size:25.5px;font-weight:800;line-height:26px;letter-spacing:-0.02em}\n.x-ladder-home-header__caret{position:absolute;left:170.4px;top:14.3px;display:block;width:9px;height:5px}\n.x-ladder-home-header__streak{position:absolute;left:282.4px;top:7.3px;display:flex;align-items:center;font-family:'Barlow Condensed',system-ui,sans-serif;font-size:17.5px;font-weight:800;line-height:18px}\n.x-ladder-home-header__bolt{display:block;width:7.6px;height:12px;margin-left:2.6px;transform:translateY(0.8px)}\n.x-ladder-home-header__avatar{position:absolute;left:321.3px;top:0;display:flex;align-items:center;justify-content:center;width:33.5px;height:33.5px;border-radius:50%;background:#2A2A2A;font-size:12.5px;font-weight:600;letter-spacing:0.02em}\n.x-ladder-home-header__chips{display:flex;gap:7.8px;margin-top:19.5px}\n.x-ladder-home-header__chip{display:flex;align-items:center;gap:6.4px;height:33.5px;padding:0 14.6px 0 16.2px;border:1px solid transparent;border-radius:999px;background:linear-gradient(135deg,#141412 0%,#22231E 100%) padding-box,linear-gradient(to top right,#2F2F2D 0%,#666664 30%,#8E8E8C 50%,#666664 70%,#2F2F2D 100%) border-box;font-size:11.5px;font-weight:500;letter-spacing:-0.02em}\n.x-ladder-home-header__ico{display:block;flex:none;width:9.6px;height:12.6px}\n.x-ladder-home-header__ico--round{width:11.8px;height:11.8px}\n.x-ladder-home-header__ico--flex{width:13.4px;height:12.7px}\n.x-ladder-home-header__week{display:grid;grid-template-columns:repeat(7,54.2px);margin:26.5px 0 0 -12.1px}\n.x-ladder-home-header__day{display:flex;flex-direction:column;align-items:center;color:#AFAFAF}\n.x-ladder-home-header__day--today{color:#FFFFFF}\n.x-ladder-home-header__dname{font-size:11.8px;line-height:12px;letter-spacing:-0.03em}\n.x-ladder-home-header__day--today .x-ladder-home-header__dname{font-weight:700}\n.x-ladder-home-header__dmark{position:relative;display:flex;align-items:center;justify-content:center;width:26.7px;height:26.7px;margin-top:6.2px}\n.x-ladder-home-header__ring{position:absolute;left:0;top:0;display:block;width:26.7px;height:26.7px}\n.x-ladder-home-header__check{display:block;width:19px;height:19px}\n.x-ladder-home-header__dnum{font-size:12.5px;line-height:12px;letter-spacing:-0.02em;color:#ACACAC;font-weight:400}",
