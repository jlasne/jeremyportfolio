{
  "name": "grid-tycoon",
  "private": true,
  "version": "1.0.0",
  "description": "Grid Tycoon: a turn-based energy and compute business sim, served at jeremylasne.com/games/grid-tycoon.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/publish.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "sprites": "node scripts/sprites/build.mjs",
    "build:edge": "node scripts/build-edge.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "5.2.7",
    "@fontsource/pixelify-sans": "5.2.7",
    "@fontsource/silkscreen": "5.2.7",
    "@supabase/supabase-js": "2.117.3",
    "pixi.js": "8.20.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.27.0",
    "pngjs": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
