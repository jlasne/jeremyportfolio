# The decision model and the vision fallback both go through OpenRouter.
# The same key the Convex deployment holds works here: one account, two places.
OPENROUTER_API_KEY=sk-or-...

# Optional. Same two names the backend reads, so one export covers both.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# The brandmatch client API. The same key the app stores under brandmatch.key.
BRANDMATCH_API=https://limitless-ladybug-747.eu-west-1.convex.site
BRANDMATCH_API_KEY=...
